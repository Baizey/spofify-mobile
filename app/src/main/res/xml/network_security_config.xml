<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- ServerAddress accepts explicit HTTP and HTTPS origins, including hostnames
         and public IPs; authenticated requests remain bound to that exact origin. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
